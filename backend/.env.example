# Server configuration
PORT=5000
NODE_ENV=development

# Database connections
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/uiu_alumni
DATABASE_URL_TEST=postgres://USER:PASSWORD@127.0.0.1:5432/uiu_alumni_test

# JWT secret (min 32 chars)
JWT_SECRET=replace_with_48_random_bytes_hex
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# App URLs and CORS
APP_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5000

# Mailer configuration (log | smtp)
MAIL_MODE=log
MAIL_FROM="UIU Alumni Portal <no-reply@uiu.ac.bd>"
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# File uploads
UPLOAD_DIR=./uploads
MAX_CV_MB=5
